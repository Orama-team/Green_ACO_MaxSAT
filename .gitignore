# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Tooling caches and test coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Build and packaging outputs
build/
dist/
.dist/
*.egg-info/
pip-wheel-metadata/

# Notebook and OS/editor junk
.ipynb_checkpoints/
.DS_Store
Thumbs.db
.idea/
.vscode/

# Logs
*.log

# ── Generated experiment artifacts ──────────────────────────────────────────
# The benchmark instances are not redistributed: they come from the MaxSAT
# Evaluation 2024 distribution. scripts/prepare_data.py names every file.
data/mse24/

# Checkpoints are disposable resume state; deleting them forces a clean re-run.
results/checkpoints/

# Manifests record the machine and arguments of a run, so they are per-run.
results/MANIFEST.json

# figures/ and results/*.csv are generated but intentionally tracked: the
# figures are the deliverable, and results/shipped/ is the recorded evidence
# behind them.

# Trained models are build artefacts. A pickle also executes arbitrary code
# on load, so the binary is not committed; run scripts/train_model.py to
# regenerate it. models/README.md explains how.
models/*.pkl

# Large dataset archives
*.zip
mse24_instances.zip
